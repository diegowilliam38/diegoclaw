# ============================================================
# DiegoClaw — Exemplo de variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais
# NUNCA commite o .env com valores reais
# ============================================================

# --- Telegram ---
# Token do seu bot (obtido via @BotFather)
TELEGRAM_BOT_TOKEN=

# IDs de usuários autorizados (whitelist), separados por vírgula
# Ex: TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
# Para descobrir seu ID: envie mensagem para @userinfobot no Telegram
TELEGRAM_ALLOWED_USER_IDS=

# --- OpenAI ---
# Chave da API OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Modelo principal — opções válidas:
# gpt-5       → RECOMENDADO: melhor inteligência com ótimo custo (padrão)
# gpt-5.4     → versão mais avançada da família GPT-5
OPENAI_MODEL=gpt-5

# --- Fallback LLM (DeepSeek) ---
# Opcional: usado como fallback se OpenAI falhar
DEEPSEEK_API_KEY=

# --- Agent Config ---
# Número máximo de iterações do ReAct loop antes de desistir
MAX_ITERATIONS=5

# Tamanho da janela de memória (quantas mensagens do histórico incluir no contexto)
MEMORY_WINDOW_SIZE=20

# --- Provider Principal ---
# 'openai' | 'deepseek'
PRIMARY_PROVIDER=openai

# --- Integrações MCP (Opcionais) ---

# Notion MCP: preencha com sua Notion Integration Token para habilitar
# Gere em: https://www.notion.so/my-integrations
NOTION_API_KEY=

# N8N MCP: defina como 'true' para habilitar conexão com servidor n8n local
N8N_MCP_ENABLED=false
